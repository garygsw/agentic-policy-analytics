# Copy to .env, or run: python3 scripts/set_keys.py
# .env is gitignored. Never commit real keys.

# Primary LLM provider
OPENAI_API_KEY=
# Fallback LLM provider
ANTHROPIC_API_KEY=

# Optional: web search tool
TAVILY_API_KEY=
# Optional: Jev decision-model trial
TYPESAFE_API_KEY=

# Optional settings (defaults shown)
# Rerank search results with a local cross-encoder (off: it ranked worse in our evaluation)
# RAG_RERANK=false
