# Copy to .env, or run: python3 scripts/set_keys.py
# .env is gitignored. Never commit real keys.

# LLM providers: both are required, as each is the other's fallback
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: web search tool
TAVILY_API_KEY=
# Optional: Jev decision-model trial
TYPESAFE_API_KEY=
# Optional: NASA FIRMS fire hotspots, to refresh the Southeast Asia haze data (free map key)
FIRMS_MAP_KEY=

# Optional settings (defaults shown)
# Rerank search results with a local cross-encoder (off: it ranked worse in our evaluation)
# RAG_RERANK=false
# The reviewer checks each report statement against what it cites (off: cheaper and faster)
# CLAIM_CHECK=true

# Deployment on a server (README, "Deployment"). Docker Compose reads these too.
# Where browsers reach the API; built into the web image, so rebuild it after a change
# PUBLIC_API_URL=http://localhost:8000
# The web UI's address, which the API accepts browser requests from (a JSON list)
# API_CORS_ORIGINS=["http://localhost:3000"]
# 127.0.0.1 keeps the API and UI ports off the network, for a reverse proxy on the same machine
# BIND_ADDRESS=0.0.0.0
# Logs: text (for a terminal) or json (one JSON object per line, for a log platform)
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# Optional: LangSmith tracing of every graph step and LLM call. It sends prompts and data to LangSmith.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=policy-analytics
