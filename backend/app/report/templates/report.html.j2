<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ report.title if report else L.automated }}</title>
<style>
  :root {
    --bg: #faf9f6; --surface: #ffffff; --text: #1d1c19; --muted: #6b6860; --line: #e8e5dd;
    --accent: #c96442; --accent-soft: #f6e9e3; --ok: #2f6b45; --ok-soft: #e6f1e9; --warn: #8a5a12; --warn-soft: #fbf0dc;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #1f1e1c; --surface: #272624; --text: #ecebe7; --muted: #a29f97; --line: #3a3835;
            --accent: #e08a6a; --accent-soft: #3a2b25; --ok: #8cc8a0; --ok-soft: #22322a; --warn: #e6b866; --warn-soft: #3a3020; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 16px/1.65 -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, "Helvetica Neue", Arial, sans-serif; }
  .page { max-width: 820px; margin: 0 auto; padding: 48px 24px 64px; }
  .eyebrow { color: var(--accent); font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; margin: 0 0 8px; }
  h1 { font: 600 32px/1.25 Georgia, "Times New Roman", serif; margin: 0 0 12px; letter-spacing: -.01em; }
  h2 { font: 600 20px/1.3 Georgia, "Times New Roman", serif; margin: 40px 0 14px; }
  .question { color: var(--muted); margin: 0 0 16px; }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badge { font-size: 13px; padding: 4px 10px; border-radius: 999px; }
  .badge.ok { background: var(--ok-soft); color: var(--ok); }
  .badge.warn { background: var(--warn-soft); color: var(--warn); }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 20px 24px; }
  .summary { margin-top: 28px; font-size: 17px; }
  .summary p { margin: 0; }
  ol.findings { padding-left: 22px; } ol.findings li { margin: 0 0 12px; padding-left: 4px; }
  a { color: var(--accent); }
  a.cite { display: inline-block; font-size: 12px; line-height: 1; padding: 3px 6px; margin-left: 3px; border-radius: 6px;
           background: var(--accent-soft); text-decoration: none; vertical-align: 2px; }
  figure.chart { margin: 0 0 20px; }
  figcaption { font-weight: 600; margin-bottom: 8px; }
  .plot { width: 100%; min-height: 360px; }
  .plot.unavailable { min-height: 0; }
  details summary { cursor: pointer; color: var(--muted); font-size: 14px; margin-top: 8px; }
  details.facts > summary { color: var(--text); list-style-position: outside; }
  details.facts > summary h2 { display: inline; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; margin-top: 8px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 600; }
  td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  tr:target, li:target { background: var(--accent-soft); }
  ul.caveats li { margin-bottom: 8px; }
  .flag { display: block; margin-top: 4px; font-size: 13px; color: var(--warn, #9a5b00); }
  .flash { background: var(--accent-soft); transition: background 0.4s; border-radius: 6px; }
  ol.sources li { margin-bottom: 14px; }
  .muted { color: var(--muted); } .small { font-size: 13px; }
  .warning { background: var(--warn-soft); color: var(--warn); border-radius: 8px; padding: 6px 10px; margin-top: 6px; font-size: 14px; }
  footer { margin-top: 48px; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  @media print { .plot { break-inside: avoid; } details { display: block; } }
</style>
</head>
<body>
<main class="page">
  <header>
    <p class="eyebrow">{{ L.eyebrow }} · {{ L.generated }} {{ generated }}</p>
    <h1>{{ report.title if report else L.automated }}</h1>
    <p class="question">{{ L.question }}: {{ question }}</p>
    <div class="badges">
      {% if report and warnings %}<span class="badge warn">⚠ {{ L.some_unverified }}</span>
      {% elif report %}<span class="badge ok">✓ {{ L.checked }}</span>
      {% else %}<span class="badge warn">{{ L.automated }}</span>{% endif %}
      {% if review_note %}<span class="badge warn">{{ L.reviewer }}: {{ review_note }}</span>{% endif %}
    </div>
  </header>

  {% if report %}
  <section class="card summary"><p>{{ report.summary }}</p>
    {% for w in warnings.get("summary", []) %}<p class="flag">⚠ {{ L.unverified }}: {{ w }}</p>{% endfor %}</section>

  <section>
    <h2>{{ L.findings }}</h2>
    <ol class="findings">
      {% for finding in report.findings %}
      <li>{{ finding.text }}{% for anchor, label in finding.citations|citation_groups %}<a class="cite" href="#{{ anchor }}">{{ label }}</a>{% endfor %}
        {% for w in warnings.get("finding " ~ loop.index, []) %}<span class="flag">⚠ {{ L.unverified }}: {{ w }}</span>{% endfor %}</li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if charts %}
  <section>
    <h2>{{ L.charts }}</h2>
    {% for chart in charts %}
    <figure class="card chart" id="{{ chart.id }}">
      <figcaption>{{ chart.id }} · {{ chart.title }}</figcaption>
      <div class="plot" data-chart="{{ chart.id }}"></div>
      <details>
        <summary>{{ L.data }}</summary>
        <table>
          <thead><tr>{% for column in chart.table.columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
          <tbody>
          {% for row in chart.table.rows %}
            <tr>{% for cell in row %}{% if loop.first %}<td>{{ cell }}</td>{% else %}<td class="num">{{ cell|number if cell is not none else "" }}</td>{% endif %}{% endfor %}</tr>
          {% endfor %}
          </tbody>
        </table>
      </details>
      <p class="muted small">{{ L.source }}: {% for s in chart.sources %}<a href="#{{ s }}">{{ s }}</a>{{ ", " if not loop.last }}{% endfor %}</p>
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  {% if report and report.caveats %}
  <section>
    <h2>{{ L.caveats }}</h2>
    <ul class="caveats">{% for caveat in report.caveats %}<li>{{ caveat.text }}{% for anchor, label in caveat.citations|citation_groups %}<a class="cite" href="#{{ anchor }}">{{ label }}</a>{% endfor %}
      {% for w in warnings.get("caveat " ~ loop.index, []) %}<span class="flag">⚠ {{ L.unverified }}: {{ w }}</span>{% endfor %}</li>{% endfor %}</ul>
  </section>
  {% endif %}

  {% if sources %}
  <section>
    <h2>{{ L.sources }}</h2>
    <ol class="sources">
      {% for s in sources %}
      <li id="{{ s.id }}">
        {% if s.kind in ("document", "web") %}
        <strong>[{{ s.id }}] {{ s.title }}</strong>{% if s.agency %} · {{ s.agency }}{% endif %}<br>
        <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.url }}</a><br>
        <span class="muted small">{{ L.kinds[s.kind] }}{% if s.published %} · {{ s.published[:10] }}{% endif %}</span>
        {% if s.untrusted %}<div class="warning">{{ L.untrusted }}</div>{% endif %}
        {% else %}
        <strong>[{{ s.id }}] {{ s.title }}</strong> · {{ s.agency }}<br>
        <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.url }}</a><br>
        <span class="muted small">{{ L.kinds.dataset }} · {{ L.retrieved }} {{ s.retrieved_at }} · {{ L.origin.get(s.origin, s.origin) }} · {{ s.licence }}</span>
        {% if s.quality %}<div class="muted small">{{ L.quality }}: {{ s.quality }}</div>{% endif %}
        {% if s.warning %}<div class="warning">{{ s.warning }}</div>{% endif %}
        {% endif %}
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if facts %}
  <section>
    <details class="facts" {{ "open" if not report }}>
    <summary><h2>{{ L.facts }} ({{ facts|length }})</h2></summary>
    <table>
      <thead><tr><th>ID</th><th>{{ L.fact }}</th><th>{{ L.value }}</th><th>{{ L.unit }}</th><th>{{ L.method }}</th><th>{{ L.source }}</th></tr></thead>
      <tbody>
      {% for f in facts %}
        <tr id="{{ f.id }}"><td>{{ f.id }}</td><td>{{ f.label }}</td><td class="num">{{ f.value|number }}</td><td>{{ f.unit }}</td><td class="muted">{{ f.method }}</td>
          <td>{% for s in f.sources %}<a href="#{{ s }}">{{ s }}</a>{{ ", " if not loop.last }}{% endfor %}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    </details>
  </section>
  {% endif %}

  <footer><p>{{ L.footer }}</p><p>{{ L.attribution }} <a href="https://data.gov.sg/open-data-licence" target="_blank" rel="noopener noreferrer">data.gov.sg/open-data-licence</a></p></footer>
</main>

<script type="application/json" id="chart-specs">{{ chart_specs|tojson }}</script>
<script>
  // A citation can point into the collapsed facts table: open it, then scroll to the cited row.
  function revealTarget() {
    var el = location.hash && document.getElementById(location.hash.slice(1));
    var box = el && el.closest("details");
    if (box && !box.open) { box.open = true; el.scrollIntoView({ block: "center" }); }
  }
  window.addEventListener("hashchange", revealTarget); revealTarget();

  // Embedded in the app, the report sits in a frame as tall as the report, so the frame never scrolls; the page
  // around it does. The report therefore sends its height, and asks the page to scroll to a citation's target.
  // Only a height and a position are sent.
  if (window.parent !== window) {
    document.documentElement.style.overflow = "hidden";
    var postHeight = function () {
      window.parent.postMessage({ type: "report-height", height: document.documentElement.scrollHeight }, "*");
    };
    new ResizeObserver(postHeight).observe(document.body);
    window.addEventListener("load", postHeight);
    document.addEventListener("click", function (event) {
      var link = event.target.closest('a[href^="#"]');
      var target = link && document.getElementById(link.getAttribute("href").slice(1));
      if (!target) return;
      event.preventDefault();
      var box = target.closest("details");
      if (box && !box.open) box.open = true;  // a fact sits in the collapsed facts table
      target.classList.add("flash");
      setTimeout(function () { target.classList.remove("flash"); }, 1800);
      window.parent.postMessage({ type: "report-scroll", top: target.getBoundingClientRect().top + window.scrollY }, "*");
    });
  }
</script>
{% if charts %}
<script src="{{ plotly_url }}" integrity="{{ plotly_sri }}" crossorigin="anonymous"></script>
<script>
  (function () {
    var specs = JSON.parse(document.getElementById("chart-specs").textContent);
    var dark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
    var ink = dark ? "#ecebe7" : "#1d1c19", grid = dark ? "#3a3835" : "#e8e5dd";
    document.querySelectorAll(".plot").forEach(function (el) {
      var spec = specs[el.dataset.chart];
      if (!window.Plotly || !spec) { el.classList.add("unavailable"); return; }
      var layout = Object.assign({}, spec.layout, {
        title: { text: "" }, margin: { t: 16, r: 56, b: 48, l: 64 },  // the caption above already names the chart
        paper_bgcolor: "rgba(0,0,0,0)", plot_bgcolor: "rgba(0,0,0,0)", font: { color: ink, size: 13 },
        xaxis: Object.assign({ gridcolor: grid }, spec.layout.xaxis), yaxis: Object.assign({ gridcolor: grid }, spec.layout.yaxis)
      });
      Plotly.newPlot(el, spec.data, layout, { displaylogo: false, responsive: true });
    });
  })();
</script>
{% endif %}
</body>
</html>
